{
  "name": "anno",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "rimraf --glob '**/.next' '**/.expo' '**/.turbo'",
    "dev": "turbo run dev",
    "extract": "turbo run extract",
    "lint": "ultracite fix",
    "nuke": "bun clean '**/node_modules' bun.lock",
    "prepare": "husky",
    "typecheck": "turbo run typecheck",
    "typegen": "turbo run typegen"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "rimraf": "^6.1.4",
    "turbo": "^2.11.10",
    "ultracite": "8.1.1"
  },
  "packageManager": "bun@1.4.2"
}
